/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

nextflow.enable.dsl = 2

// Global defaults
params {

    // Input parameters
    input =                 null
    outdir =                "../output"
    protocol =              null
    seqspec_file =          null
    bc_whitelist =          null
    bc_whitelist_parse_splitwells = null
    parse_collapse_bc1 =    true                    // Parse: merge each round-1 well's T/R/X barcodes into one cell barcode before mapping
    cram_type =             "illumina"              // samplesheet 'cram' files: "illumina" (both reads, indices in BC/QT) or "ultima" (ScaleBio, barcodes in tags)
    cram_reference =        null                    // FASTA for reference-compressed CRAMs; unaligned CRAMs need none
    cram_index_format =     "auto"                  // samtools fastq --index-format for the BC tag; "auto" counts the indices from the separators
    run_method =            "standard"              // "standard", "geneext_only", "external_pipeline_only", "post_mapping"
    previous_outdir =       null                    // Results directory "post_mapping" reads the mapping results back from; defaults to outdir
    mapping_software =      "starsolo"              // "starsolo", "alevin", "both"/"alevin_starsolo", "alevin_subsampled_starsolo"
    cellfilter_method =     "second_derivative"     // "star_solocellfilter", "second_derivative", "manual_cutoff"
    alevin_usa_counts =     "SUA"                   // "SUA", "SA", "S", "UA", "U": alevin-fry USA blocks summed per gene; only "SUA" matches STARsolo's GeneFull_Ex50pAS
    alevin_resolution =     "cr-like-em"            // "cr-like", "cr-like-em": alevin-fry UMI resolution; "cr-like" discards gene-ambiguous UMIs, like STARsolo's "Unique"

    // References
    ref_fasta =             null
    ref_gtf =               null
    ref_gtf_alt =           null                    // Deprecated, no effect: Cell Ranger and split-pipe use ref_gtf
    ref_fasta_addfeature =  null
    ref_gtf_addfeature =    null

    // Gene extension parameters
    perform_geneext =       false
    geneext_downstream =    "geneext_only"          // With perform_geneext: "geneext_only" maps and analyses only the GeneExt runs, "both" also the standard runs
    geneext_gtf =           null
    geneext_bam_only =      true                    // Strip the STARsolo pass mapped only for GeneExt down to a BAM
    geneext_subsample_nreads = 50000000             // Per-sample cap on the reads reaching GeneExt, so one sample cannot dominate the extension; 0 = off
    geneext_subsamplebam =  null                    // GeneExt's own --subsamplebam, applied to the MERGED bam; does not balance samples

    // Subsampling parameters
    subsample_nreads =      100000000

    // 10x Genomics specific parameters
    perform_10x_saturate =  true
    saturation_target =     0.7

    // ScaleBio specific parameters
    scalebio_max_mismatches = null                  // ScaleBio: substitutions corrected per barcode; null = the protocol's (1)
    scalebio_i5_revcomp =   "auto"                  // ScaleBio: "auto" (from the reads), "true" or "false": whether I2 reads the PCR index reverse-complemented
    scalebio_write_unassigned = false               // ScaleBio: also write the reads whose RT/PCR wells belong to no sample
    scalebio_ultima_tags =  null                    // ScaleBio, Ultima CRAMs: 'segment=TAG,...' of the barcodes; null = the protocol's
    scalebio_ultima_umi =   null                    // ScaleBio, Ultima CRAMs: where the UMI is, 'tag:XX' or 'seq:START:LENGTH'; null = the protocol's

    // MARS-seq read layouts (values are set in conf/seqtech_parameters.config)
    marsseq_read1_design =  null
    marsseq_read2_design =  null

    // Demultiplexing parameters
    perform_demultiplexing = true
    bcl2fastq =             null
    oak_demux_max_mismatches = null     // values are set in conf/seqtech_parameters.config

    // Trimming parameters (values are set in conf/seqtech_parameters.config)
    perform_trimming =      true
    fastp_length_required = null
    fastp_qualified_quality_phred = null

    // STAR specific parameters
    star_index =            null
    star_genomeSAindexNbases = null
    star_genomeSAsparseD =  null
    star_solocellfilter =   null
    star_soloFeatures =     null
    star_outFilterScoreMin= null
    star_outSAMunmapped =   null
    star_outSAMattributes=  null
    star_soloTypestring =   null
    star_soloCBmatchWLtype= null
    star_soloUMIfiltering=  null
    star_soloMultiMappers=  null
    star_soloUMIdedup =     null
    star_clipAdapterType =  null
    star_generateBAM =      true
    star_limitBAMsortRAM =  0                       // 0 = derive from task.memory minus the genome index
    star_limitGenomeGenerateRAM = null              // null = derive from task.memory
    star_soloStrand =       "Forward"
    star_extraargs =        null
    perform_velocity =      false                   // Adds STARsolo's Velocyto feature (spliced/unspliced/ambiguous) and an unspliced-only alevin-fry matrix

    // Mapping-rate check (STARsolo and alevin-fry), see bin/mapping_rate_guard.sh
    skip_mapping_rate_check = false                 // true = never cancel a sample for a low mapping rate
    min_mapping_rate =      10                      // % uniquely mapped (STARsolo) / % mapped (salmon) below which a sample is cancelled
    mapping_rate_action =   "abort"                 // "abort" (stop the pipeline), "skip_sample" (drop the sample, continue with the others)
    mapping_rate_check_reads = 20000000             // STARsolo: check Log.progress.out mid-run once this many reads are mapped; 0 = only at the end
    mapping_rate_poll_secs = 60                     // How often the running mapper is checked (STAR refreshes Log.progress.out every minute)

    // Alevin-fry specific parameters (values are set in conf/seqtech_parameters.config)
    alevin_bc_geometry =    null
    alevin_umi_geometry =   null
    alevin_read_geometry =  null

    // Read metrics parameters (mtDNA, rRNA, antisense); CALC_READ_METRICS runs for every STARsolo BAM
    perform_featurecounts = null                    // Deprecated, no effect: the read metrics always run
    grep_rrna =             "rRNA"
    mt_contig =             "chrM M MT"

    // Taxonomic classification parameters
    perform_kraken =        false
    kraken_db_path =        null

    // Filtering parameters
    h5ad_compression =      "gzip"                  // "gzip", "lzf" (faster to write, h5py-only), "none"
    ambient_rna_remover =   "cellsweep"             // "cellsweep", "none"/null
    perform_doublet_detection = true                // Call consensus doublets and annotate them
    perform_doublet_filtering = false               // Remove them from the UMI matrix instead of annotating (needs perform_doublet_detection)
    doublet_consensus_method  = "AnySinglet"        // Combine_Results.R method: "AnySinglet" = doublet only if ALL tools agree (intersection), "AnyDoublet" = doublet if ANY tool calls it (union)
    demuxafy_sif              = null

    // Metacells and the interactive filtering report (filtering_report.html)
    perform_metacells          = false              // Group called cells into Metacell2 metacells and build the filtering report
    mc2_target_metacell_size   = 96                 // Metacell2's target number of cells per metacell
    mc2_random_seed            = 42                 // Fixed so a rerun reproduces the assignment a selection was made on
    mc2_min_cell_umis          = 200                // Cells below this many UMIs are not grouped (__excluded__)
    mc2_max_cell_umis          = null               // Cells above this many UMIs are not grouped; null = no cap
    mc2_max_excluded_genes_fraction = null          // Metacell2's per-cell cap on excluded-gene (e.g. mito) UMIs; null = off, so mito-rich metacells stay visible
    mc2_excluded_gene_patterns = ""                 // Extra genes kept out of the grouping, besides the mitochondrial ones (space-separated regexes)
    mc2_lateral_gene_patterns  = ""                 // Genes marked lateral, e.g. cell-cycle genes (space-separated regexes)
    mc2_min_cells              = 300                // Fewest groupable cells; a sample with fewer is reported as skipped
    mc2_skip_subsampled        = true               // No metacells for the '_subsampled_starsolo' runs
    gene_annotation            = null               // Protein domains (PFAM) per gene/transcript/protein id: pfam_scan.pl output, .emapper.annotations, TSV with or without header
    gene_annotation_format     = "auto"             // auto | table | emapper | pfamscan | headerless
    gene_annotation_id_col     = "gene_id"          // Identifier column of a gene_annotation with header (eggNOG-mapper: falls back to 'query')
    gene_annotation_pfam_col   = "pfam"             // Domain column of a gene_annotation with header (eggNOG-mapper: falls back to 'PFAMs')
    gene_annotation_name_col   = null               // Gene name column of a gene_annotation with header (eggNOG-mapper: Preferred_name)
    mcfilter_max_mito_pct      = 20                 // Initial report threshold: mito UMIs per metacell (%); null = off
    mcfilter_max_doublet_pct   = 50                 // Initial report threshold: consensus doublets per metacell (%); null = off
    mcfilter_max_alpha_hat     = null               // Initial report threshold: mean CellSweep ambient fraction; null = off
    mcfilter_min_gene_umis     = 10                 // Initial report threshold: total UMIs per gene
    mcfilter_pfam_presets      = "^Ribosomal;^Histone" // Domain regexes offered as one-click presets in the report (';'-separated)
    metacell_selection         = null               // selection.json exported from filtering_report.html; rerun with -resume to apply it
    metacell_gene_mode         = "drop"             // "drop": remove excluded genes from the final matrices, "flag": keep them, flagged in var

    // Parameters for external pipelines
    perform_cellranger =    false
    rhapsody_installation = null
    splitpipe_installation = null
    splitpipe_conda_env =   null
    splitpipe_demultiplex_script =  null
    splitpipe_kit         = null

    // Input-size dependent memory requests, can be adjusted depending on the output of the resource efficiency report
    dynamic_memory = [
        STARSOLO_ALIGN: [ exponent: 0.83, ref_gb: 50, mem_gb: 25, floor_gb: 8,  cap_gb: 128 ],
        STARSOLO_INDEX: [ exponent: 0.68, ref_gb: 3,  mem_gb: 7,  floor_gb: 4,  cap_gb: 64 ],
        MTX_TO_H5AD:    [ exponent: 0.89, ref_gb: 5,  mem_gb: 11, floor_gb: 2,  cap_gb: 96  ],
        MTX_TO_10X:     [ exponent: 0.66, ref_gb: 5,  mem_gb: 9,  floor_gb: 2,  cap_gb: 48  ],
        DOUBLET_FILTER: [ exponent: 0.66, ref_gb: 5,  mem_gb: 9,  floor_gb: 3,  cap_gb: 48  ],
        SATURATION_TABLE: [ exponent: 1.0,  ref_gb: 5.4, mem_gb: 4,  floor_gb: 4,  cap_gb: 96  ],
        SUBSET_VELOCYTO_MATRICES: [ exponent: 0.9, ref_gb: 5, mem_gb: 10, floor_gb: 2, cap_gb: 48 ],
        VELOCITY_H5AD:  [ exponent: 0.9,  ref_gb: 5,  mem_gb: 12, floor_gb: 2,  cap_gb: 48  ],
        METACELL2:      [ exponent: 0.9,  ref_gb: 1,  mem_gb: 16, floor_gb: 4,  cap_gb: 96, resident_factor: 2.5 ],
        MERGE_GROUP_H5AD: [ exponent: 0.9, ref_gb: 1, mem_gb: 12, floor_gb: 4, cap_gb: 96, resident_factor: 2.5 ],
        SALMON_SPLICI:  [ exponent: 1.0,  ref_gb: 0.3,  mem_gb: 3,   floor_gb: 3, cap_gb: 64  ],
        SALMON_INDEX:   [ exponent: 1.0,  ref_gb: 0.17, mem_gb: 1,   floor_gb: 2, cap_gb: 64  ],
        ALEVIN_FRY:     [ exponent: 0.1,  ref_gb: 2.2,  mem_gb: 1.5, floor_gb: 2, cap_gb: 64  ],
        GENERATE_DASHBOARD:        [ exponent: 1.0, ref_gb: 0.14, mem_gb: 0.7, floor_gb: 1, cap_gb: 16 ],
        GENERATE_FILTERING_REPORT: [ exponent: 1.0, ref_gb: 0.1,  mem_gb: 0.5, floor_gb: 1, cap_gb: 16 ],
        KRAKEN:         [ exponent: 1.0,  ref_gb: 1,    mem_gb: 1.3, floor_gb: 2, cap_gb: 256 ],
        CELLSWEEP:               [ exponent: 1.0, ref_gb: 0.28, mem_gb: 4.7, floor_gb: 3,  cap_gb: 48 ],
        PERCELL_METRICS:         [ exponent: 1.0, ref_gb: 0.108, mem_gb: 6,  floor_gb: 2,  cap_gb: 32 ],
        FILTER_MATRICES:         [ exponent: 1.0, ref_gb: 0.32, mem_gb: 1.7, floor_gb: 2, cap_gb: 32 ],
        SECONDDERIV_CELLCALLING: [ exponent: 1.0, ref_gb: 0.14, mem_gb: 0.7, floor_gb: 2, cap_gb: 32 ],
        SUBSET_STARSOLO_CELLS:   [ exponent: 1.0, ref_gb: 0.32, mem_gb: 1.7, floor_gb: 6, cap_gb: 32 ],
        COLLAPSE_ALEVIN_USA:     [ exponent: 1.0, ref_gb: 0.14, mem_gb: 0.6, floor_gb: 6, cap_gb: 32 ],
        APPLY_METACELL_FILTER:   [ exponent: 1.0, ref_gb: 0.01, mem_gb: 0.5, floor_gb: 4, cap_gb: 32 ],
        MAPPING_STATS:           [ exponent: 1.0, ref_gb: 0.28, mem_gb: 3.2, floor_gb: 2, cap_gb: 28 ],
        SCDBLFINDER:             [ exponent: 1.0, ref_gb: 0.05, mem_gb: 10, floor_gb: 3, cap_gb: 10 ],
        SCRUBLET:                [ exponent: 1.0, ref_gb: 0.05, mem_gb: 6,  floor_gb: 3, cap_gb: 6  ],
    ]

    // Input-size dependent time limits, can be adjusted depending on the output of the resource efficiency report
    dynamic_time = [
        STARSOLO_ALIGN:    [ exponent: 1.0, ref_gb: 3.12,  time_h: 1.03,   floor_h: 1,    cap_h: 24 ],
        STARSOLO_INDEX:    [ exponent: 1.0, ref_gb: 0.29,  time_h: 0.07,   floor_h: 1,    cap_h: 4 ],
        ALEVIN_FRY:        [ exponent: 1.0, ref_gb: 2.24,  time_h: 0.091,  floor_h: 1,    cap_h: 6 ],
        FASTQC:            [ exponent: 1.0, ref_gb: 2.24,  time_h: 0.19,   floor_h: 1,    cap_h: 6 ],
        SUBSAMPLE_FASTQS:  [ exponent: 1.0, ref_gb: 0.74,  time_h: 0.143,  floor_h: 1,    cap_h: 8 ],
        MARSSEQ_BUILD_READS: [ exponent: 1.0, ref_gb: 0.19, time_h: 0.026, floor_h: 0.75, cap_h: 6 ],
        OAK_DEMUX:         [ exponent: 1.0, ref_gb: 0.74,  time_h: 0.284,  floor_h: 1,    cap_h: 6 ],
        PARSEBIO_CUSTOM_DEMUX: [ exponent: 1.0, ref_gb: 0.036, time_h: 0.0051, floor_h: 1, cap_h: 8 ],
        PARSEBIO_COLLAPSE_BC1: [ exponent: 1.0, ref_gb: 0.036, time_h: 0.0051, floor_h: 1, cap_h: 8 ],
        SCALEBIO_DEMUX:    [ exponent: 1.0, ref_gb: 1.0,   time_h: 0.12,   floor_h: 1,    cap_h: 24 ],
        CRAM_TO_FASTQ:     [ exponent: 1.0, ref_gb: 1.0,   time_h: 0.05,   floor_h: 1,    cap_h: 12 ],
        CALC_READ_METRICS: [ exponent: 1.0, ref_gb: 1.35,  time_h: 0.16,   floor_h: 1,    cap_h: 6 ],
        SAMTOOLS_INDEX:    [ exponent: 1.0, ref_gb: 1.35,  time_h: 0.014,  floor_h: 0.75, cap_h: 4 ],
        SATURATION_TABLE:  [ exponent: 1.0, ref_gb: 1.35,  time_h: 0.66,   floor_h: 1,    cap_h: 8 ],
        SAMTOOLS_SUBSAMPLE: [ exponent: 1.0, ref_gb: 1.35, time_h: 0.051,  floor_h: 0.75, cap_h: 4 ],
        SAMTOOLS_MERGE:    [ exponent: 1.0, ref_gb: 1.35,  time_h: 0.011,  floor_h: 0.75, cap_h: 4 ],
        CELLSWEEP:         [ exponent: 1.0, ref_gb: 0.30,  time_h: 0.16,   floor_h: 0.75, cap_h: 8 ],
        GENE_EXT:          [ exponent: 1.0, ref_gb: 1.3,   time_h: 0.72,   floor_h: 2,    cap_h: 24 ],
    ]

    // CPU counts that step up above an input size, inert while above_gb is null
    dynamic_cpus = [
        STARSOLO_ALIGN:    [ above_gb: 1.5,  cpus: 16 ],
        KRAKEN:            [ above_gb: 1,    cpus: 8  ],
        STARSOLO_INDEX:    [ above_gb: 1,    cpus: 8  ],
    ]

    // Boilerplate parameters
    code_dir =              null
    publish_dir_mode =      'copy'
    email =                 null
    email_on_fail =         null
    plaintext_email =       false
    hook_url =              null
    monochrome_logs =       true
    help =                  false
    help_full =             false
    version =               false
    trace_report_suffix =   new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
    pipeline_version =      '0.2.4'

    schema_before_text = """
-\033[2m----------------------------------------------------\033[0m-
                                        \033[0;32m,--.\033[0;30m/\033[0;32m,-.\033[0m
\033[0;34m        ___     __   __   __   ___     \033[0;32m/,-._.--~\'\033[0m
\033[0;34m  |\\ | |__  __ /  ` /  \\ |__) |__         \033[0;33m}  {\033[0m
\033[0;34m  | \\| |       \\__, \\__/ |  \\ |___     \033[0;32m\\`-._,-`-,\033[0m
                                        \033[0;32m`._,._,\'\033[0m
\033[0;35m  biodiversitycellatlas/bca_preprocessing ${params.pipeline_version}\033[0m
-\033[2m----------------------------------------------------\033[0m-
"""

    schema_after_text = """
    https://doi.org/10.1038/s41587-020-0439-x

* Software dependencies
    https://github.com/biodiversitycellatlas/bca_preprocessing/CITATIONS.md

"""

    // GPU options — only applied when running with `-profile gpu`.
    gpu_cluster_options        = '--partition=gpu --gres=gpu:1g.10gb:1'

    // Config options
    config_profile_name        = null
    config_profile_description = null
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true                // Check every parameter (types, path formats, existence) and the samplesheet against nextflow_schema.json
}


// Load base.config by default for all pipelines
includeConfig 'conf/base.config'


/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Define profiles for config files
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow requires the custom config files to be defined in the nextflow.config
    file as a profile, to be able to reference the params in this file.
----------------------------------------------------------------------------------------
*/
profiles {
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    micromamba {
        conda.enabled           = true
        conda.useMicromamba     = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
        process {
            resourceLimits = [
                cpus  : 2,
                memory: 4.GB,
                time  : 1.h
            ]
        }
    }
    test {
        includeConfig 'conf/test.config'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
}


// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load nf-core/demo custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"
includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ? "${params.custom_config_base}/pipeline/demo.config" : "/dev/null"


// Include seqtech-specific parameters
includeConfig "conf/seqtech_parameters.config"


// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Nextflow's own default, set explicitly: Nextflow 25.10.0 leaves it unset and every
// Apptainer image pull fails with a NullPointerException
apptainer.pullTimeout = 20.m


// Execution reports
// Written to execution_reports/ in the launch directory, not to params.outdir: an outdir
// set in a -c config file is read after this file, so "${params.outdir}" here would
// always be the default. Read back by bin/resource_efficiency.py, which matches each
// trace to its outdir through the trace_report_suffix in <outdir>/pipeline_info/params_*.json,
// to report how much of each scheduled resource was actually used and to propose
// retuned values for conf/base.config.
timeline {
    enabled = true
    file    = "execution_reports/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "execution_reports/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "execution_reports/execution_trace_${params.trace_report_suffix}.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,submit,start,complete,duration,realtime,queue,cpus,memory,time,%cpu,%mem,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,error_action'
}


// Manifest
// `nextflow pull/run` also clones submodules/ at their pinned commits
manifest {
    name            = 'biodiversitycellatlas/bca_preprocessing'
    author          = 'Bonita van Waardenburg'
    homePage        = 'https://github.com/biodiversitycellatlas/bca_preprocessing'
    description     = 'Biodiversity Cell Atlas Pre-processing Pipeline'
    mainScript      = 'main.nf'
    version         = params.pipeline_version
    nextflowVersion = '>=25.04.0'
    recurseSubmodules = true
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.3.0' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    monochromeLogs = params.monochrome_logs
    ignoreParams = ['schema_before_text', 'schema_after_text', 'dynamic_memory', 'dynamic_time', 'dynamic_cpus', 'seqtech_parameters']
    help {
        enabled = true
        command = "nextflow run -profile <institution_config>,conda -c /path/to/custom_config"
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
        beforeText = params.schema_before_text
        afterText = params.schema_after_text
    }
    summary {
        beforeText = params.schema_before_text
        afterText = params.schema_after_text
    }
}
