params {
    // General parameters. The reads and the reference are those of the 10x example
    // (examples/10x), here described by a seqspec file instead of a built-in protocol.
    input = "${projectDir}/examples/seqspec/conf/spis_seqspec_samplesheet.csv"
    outdir = "${projectDir}/examples/seqspec/output/"
    ref_gtf = "${projectDir}/examples/10x/test_data/spis_long.annot.gtf"
    ref_fasta = "${projectDir}/examples/10x/test_data/spis_gDNA.fa"

    // Protocol-specific parameters. The barcode and UMI positions of both mappers come from
    // the seqspec file, and so does the barcode whitelist: bc_whitelist is left unset, so
    // the onlist of the spec's barcode region is downloaded.
    protocol = "seqspec"
    seqspec_file = "${projectDir}/examples/seqspec/conf/spis_10xv3.seqspec.yaml"

    // Both mappers, to see that each gets the layout
    mapping_software = "both"

    // Enable/disable processes
    perform_geneext = false
    perform_10x_saturate = true
    perform_doublet_detection = false
    perform_kraken = false
}
