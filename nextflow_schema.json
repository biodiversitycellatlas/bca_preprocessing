{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/biodiversitycellatlas/bca_preprocessing//nextflow_schema.json",
    "title": "biodiversitycellatlas/bca_preprocessing pipeline parameters",
    "description": "Biodiversity Cell Atlas Pre-processing Pipeline",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output data. Relative paths are read from the launch directory; relative FASTQ paths in the samplesheet are read from the samplesheet's folder.",
            "required": ["input", "outdir", "protocol", "ref_fasta", "ref_gtf"],
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_input.json",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Path to comma-separated file containing information about the samples in the experiment.",
                    "help_text": "You will need to create a design file with information about the samples in your experiment before running the pipeline. Use this parameter to specify its location. It has to be a comma-separated file with a header row and at least the columns 'sample', 'fastq_cDNA' and 'fastq_BC_UMI'. Relative FASTQ paths are read from the samplesheet's folder.",
                    "fa_icon": "fas fa-file-csv"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "The output directory where the results will be saved, created if missing. You have to use absolute paths to storage on Cloud infrastructure.",
                    "fa_icon": "fas fa-folder-open",
                    "default": "../output"
                },
                "protocol": {
                    "type": "string",
                    "description": "Sequencing technology, which selects the pre-processing and the read layout in conf/seqtech_parameters.config.",
                    "enum": [
                        "10xv1", "10xv2", "10xv3", "10xv4", "ultima_genomics", "oak_v1",
                        "parse_biosciences_WT_mini", "parse_biosciences_WT",
                        "bd_rhapsody_v1", "bd_rhapsody_enhancedbeads",
                        "sciRNAseq3", "marsseq_v1", "marsseq_v2", "seqspec"
                    ]
                },
                "ref_fasta": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Genome FASTA."
                },
                "ref_gtf": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Gene annotation GTF."
                },
                "ref_gtf_alt": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Alternative GTF for the Cell Ranger and split-pipe references; defaults to 'ref_gtf'."
                },
                "ref_fasta_addfeature": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Extra sequences (e.g. rRNA) appended to 'ref_fasta' for mapping."
                },
                "ref_gtf_addfeature": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Extra annotation (e.g. rRNA) appended to 'ref_gtf' for mapping."
                },
                "bc_whitelist": {
                    "type": "string",
                    "description": "Barcode whitelist(s): one or more URLs or paths separated by whitespace, one per barcode segment in segment order. URLs are downloaded."
                },
                "bc_whitelist_parse_splitwells": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Well whitelist the Parse Biosciences demultiplexing splits the reads on."
                },
                "run_method": {
                    "type": "string",
                    "default": "standard",
                    "enum": ["standard", "geneext_only", "external_pipeline_only", "post_mapping"]
                },
                "previous_outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Results directory the 'post_mapping' run method reads the published mapping results back from. Defaults to 'outdir'."
                },
                "seqspec_file": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "seqspec file with the read layout, for protocol 'seqspec'."
                },
                "bcl2fastq": {
                    "type": "string",
                    "description": "Extra bcl2fastq options; set per protocol in conf/seqtech_parameters.config."
                }
            }
        },
        "mapping_options": {
            "title": "Mapping options",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "mapping_software": {
                    "type": "string",
                    "default": "starsolo",
                    "enum": ["starsolo", "alevin", "both", "alevin_starsolo", "alevin_subsampled_starsolo"]
                },
                "cellfilter_method": {
                    "type": "string",
                    "default": "second_derivative",
                    "enum": ["star_solocellfilter", "second_derivative", "manual_cutoff"]
                },
                "alevin_usa_counts": {
                    "type": "string",
                    "default": "SUA",
                    "enum": ["SUA", "SA", "S", "UA", "U"],
                    "description": "alevin-fry spliced (S), unspliced (U) and ambiguous (A) counts summed into each gene's count. Only SUA matches STARsolo's GeneFull_Ex50pAS; SA matches STARsolo's Gene."
                },
                "alevin_resolution": {
                    "type": "string",
                    "default": "cr-like",
                    "enum": ["cr-like", "cr-like-em"],
                    "description": "alevin-fry UMI resolution. cr-like discards UMIs that stay ambiguous between genes, as Cell Ranger and STARsolo's matrix.mtx do; cr-like-em splits them by expectation-maximisation."
                },
                "skip_mapping_rate_check": {
                    "type": "boolean",
                    "default": false,
                    "description": "Never cancel a sample for a low mapping rate."
                },
                "min_mapping_rate": {
                    "type": "number",
                    "default": 10,
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Percentage of reads uniquely mapped (STARsolo) or mapped (salmon) below which a sample is cancelled."
                },
                "mapping_rate_action": {
                    "type": "string",
                    "default": "abort",
                    "enum": ["abort", "skip_sample"],
                    "description": "What a failed mapping-rate check does: stop the pipeline, or drop only that sample."
                },
                "mapping_rate_check_reads": {
                    "type": "integer",
                    "default": 20000000,
                    "minimum": 0,
                    "description": "STARsolo: check the mapping rate mid-run once this many reads are processed; 0 checks only at the end."
                },
                "mapping_rate_poll_secs": {
                    "type": "integer",
                    "default": 60,
                    "minimum": 1,
                    "description": "How often a running mapper is checked, in seconds."
                },
                "subsample_nreads": {
                    "type": "integer",
                    "default": 100000000,
                    "minimum": 1,
                    "description": "Reads per sample for the 'alevin_subsampled_starsolo' STARsolo runs."
                },
                "star_index": {
                    "type": "string",
                    "format": "directory-path",
                    "exists": true,
                    "description": "Prebuilt STARsolo index to map against; built in the run when unset."
                },
                "mt_contig": {
                    "type": "string",
                    "default": "chrM M MT"
                },
                "star_generateBAM": {
                    "type": "boolean",
                    "default": true,
                    "description": "Write the STARsolo BAM, needed for the read metrics, saturation and Kraken."
                },
                "star_limitBAMsortRAM": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0,
                    "description": "STAR --limitBAMsortRAM in bytes; 0 derives it from the task memory minus the genome index."
                },
                "star_limitGenomeGenerateRAM": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "STAR --limitGenomeGenerateRAM in bytes; derived from the task memory when unset."
                },
                "star_soloStrand": {
                    "type": "string",
                    "default": "Forward",
                    "enum": ["Forward", "Reverse", "Unstranded"]
                },
                "star_genomeSAsparseD": {
                    "type": "integer",
                    "minimum": 1
                },
                "star_soloFeatures": {
                    "type": "string"
                },
                "star_outFilterScoreMin": {
                    "type": "integer",
                    "minimum": 0
                },
                "star_outSAMattributes": {
                    "type": "string"
                },
                "star_outSAMunmapped": {
                    "type": "string"
                },
                "star_soloTypestring": {
                    "type": "string"
                },
                "star_soloCBmatchWLtype": {
                    "type": "string"
                },
                "star_soloUMIfiltering": {
                    "type": "string"
                },
                "star_soloMultiMappers": {
                    "type": "string"
                },
                "star_clipAdapterType": {
                    "type": "string"
                },
                "star_extraargs": {
                    "type": "string"
                },
                "star_genomeSAindexNbases": {
                    "type": "integer",
                    "minimum": 1
                },
                "star_solocellfilter": {
                    "type": "string"
                },
                "star_soloUMIdedup": {
                    "type": "string"
                },
                "alevin_bc_geometry": {
                    "type": "string"
                },
                "alevin_umi_geometry": {
                    "type": "string"
                },
                "alevin_read_geometry": {
                    "type": "string"
                }
            }
        },
        "preprocessing_options": {
            "title": "Pre-processing options",
            "type": "object",
            "description": "Protocol-specific pre-processing; the defaults per protocol are in conf/seqtech_parameters.config.",
            "default": "",
            "properties": {
                "perform_demultiplexing": {
                    "type": "boolean",
                    "default": true
                },
                "oak_demux_max_mismatches": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "OAK: Hamming distance allowed between a read's index and the aliquot's i7/i5 barcodes."
                },
                "marsseq_read1_design": {
                    "type": "string"
                },
                "marsseq_read2_design": {
                    "type": "string"
                },
                "perform_10x_saturate": {
                    "type": "boolean",
                    "default": true,
                    "description": "Compute the sequencing saturation curves with 10x_saturate."
                },
                "saturation_target": {
                    "type": "number",
                    "default": 0.7,
                    "minimum": 0,
                    "maximum": 1
                }
            }
        },
        "gene_extension_options": {
            "title": "Gene Extension options",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "perform_geneext": {
                    "type": "boolean",
                    "description": "Extend the annotation with GeneExt, from full-data STARsolo alignments, and re-map every mapper against the extended annotation."
                },
                "geneext_downstream": {
                    "type": "string",
                    "default": "geneext_only",
                    "enum": ["geneext_only", "both"],
                    "description": "Only consulted with 'perform_geneext': 'geneext_only' maps, reports and analyses downstream only the runs on the extended annotation; 'both' also the standard-annotation runs, for a comparison."
                },
                "geneext_gtf": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Extended annotation 'post_mapping' re-uses; defaults to gene_ext/geneext.gtf under 'previous_outdir'."
                },
                "geneext_bam_only": {
                    "type": "boolean",
                    "default": true,
                    "description": "Strip a STARsolo pass that is mapped only for GeneExt down to producing the BAM GeneExt reads, skipping the count matrices and the cell call."
                },
                "geneext_subsample_nreads": {
                    "type": "integer",
                    "default": 50000000,
                    "minimum": 0,
                    "description": "Per-sample cap on the reads reaching GeneExt, applied before the BAMs are merged so one deeply sequenced sample cannot dominate the extension. 0 disables it."
                },
                "geneext_subsamplebam": {
                    "type": "integer",
                    "description": "GeneExt's own --subsamplebam, applied to the merged BAM. Downsamples uniformly and so does not balance samples against each other; use 'geneext_subsample_nreads' for that."
                },
                "perform_velocity": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "featurecounts_options": {
            "title": "Read metrics options",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "perform_featurecounts": {
                    "type": "boolean",
                    "description": "Deprecated: the mtDNA, rRNA and antisense read metrics always run for a STARsolo BAM; this parameter has no effect.",
                    "hidden": true
                },
                "grep_rrna": {
                    "type": "string",
                    "default": "rRNA"
                }
            }
        },
        "filtering_options": {
            "title": "Filtering options",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "ambient_rna_remover": {
                    "type": "string",
                    "default": "cellsweep",
                    "enum": ["cellsweep", "none"]
                },
                "h5ad_compression": {
                    "type": "string",
                    "default": "gzip",
                    "enum": ["gzip", "lzf", "none"]
                },
                "perform_doublet_detection": {
                    "type": "boolean",
                    "default": true,
                    "description": "Call consensus doublets and annotate them."
                },
                "perform_doublet_filtering": {
                    "type": "boolean",
                    "default": false,
                    "description": "Remove the consensus doublets from the UMI matrix instead of annotating them (needs 'perform_doublet_detection')."
                },
                "doublet_consensus_method": {
                    "type": "string",
                    "default": "AnySinglet",
                    "description": "Combine_Results.R method; AnySinglet calls a doublet only if all tools agree."
                },
                "demuxafy_sif": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Demuxafy Singularity image; downloaded (~7.5 GB) when unset."
                }
            }
        },
        "metacell_options": {
            "title": "Metacell and filtering report options",
            "type": "object",
            "description": "Metacell2 grouping, the interactive filtering report, and applying its selection.",
            "default": "",
            "properties": {
                "perform_metacells": {
                    "type": "boolean",
                    "description": "Group called cells into Metacell2 metacells and build filtering_report.html."
                },
                "mc2_target_metacell_size": {
                    "type": "integer",
                    "default": 48,
                    "minimum": 2
                },
                "mc2_random_seed": {
                    "type": "integer",
                    "default": 42
                },
                "mc2_min_cell_umis": {
                    "type": "number",
                    "default": 200
                },
                "mc2_max_cell_umis": {
                    "type": "number"
                },
                "mc2_max_excluded_genes_fraction": {
                    "type": "number"
                },
                "mc2_excluded_gene_patterns": {
                    "type": "string"
                },
                "mc2_lateral_gene_patterns": {
                    "type": "string"
                },
                "mc2_min_cells": {
                    "type": "integer",
                    "default": 300
                },
                "mc2_skip_subsampled": {
                    "type": "boolean",
                    "default": true
                },
                "gene_annotation": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "TSV with a header giving protein domains (PFAM) per gene, transcript or protein id."
                },
                "gene_annotation_id_col": {
                    "type": "string",
                    "default": "gene_id"
                },
                "gene_annotation_pfam_col": {
                    "type": "string",
                    "default": "pfam"
                },
                "mcfilter_max_mito_pct": {
                    "type": "number",
                    "default": 20
                },
                "mcfilter_max_doublet_pct": {
                    "type": "number",
                    "default": 50
                },
                "mcfilter_max_alpha_hat": {
                    "type": "number"
                },
                "mcfilter_min_gene_umis": {
                    "type": "number",
                    "default": 10
                },
                "mcfilter_pfam_presets": {
                    "type": "string",
                    "default": "^Ribosomal;^Histone"
                },
                "metacell_selection": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "selection.json exported from filtering_report.html; rerun with -resume to apply it."
                },
                "metacell_gene_mode": {
                    "type": "string",
                    "default": "drop",
                    "enum": ["drop", "flag"]
                }
            }
        },
        "taxonomic_classification_options": {
            "title": "Taxonomic classification options",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "perform_kraken": {
                    "type": "boolean"
                },
                "kraken_db_path": {
                    "type": "string",
                    "format": "directory-path",
                    "exists": true,
                    "description": "Existing Kraken2 database; the PlusPF 16 GB database is downloaded when unset."
                }
            }
        },
        "external_pipeline_options": {
            "title": "External pipeline options",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "perform_cellranger": {
                    "type": "boolean"
                },
                "splitpipe_installation": {
                    "type": "string",
                    "format": "directory-path",
                    "exists": true
                },
                "splitpipe_conda_env": {
                    "type": "string",
                    "description": "Conda environment with split-pipe: a name, an environment file or a prefix directory."
                },
                "splitpipe_demultiplex_script": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "split-pipe's demultiplexing script; the pipeline's own demultiplexer runs when unset."
                },
                "splitpipe_kit": {
                    "type": "string"
                },
                "rhapsody_installation": {
                    "type": "string",
                    "format": "directory-path",
                    "exists": true
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "help_text": "These options are common to all nf-core pipelines and allow you to customise some of the core preferences for how the pipeline runs.\n\nTypically these options would be set in a Nextflow config file loaded for all pipeline runs, such as `~/.nextflow/config`.",
            "properties": {
                "help": {
                    "type": ["boolean", "string"],
                    "description": "Display the help message.",
                    "hidden": true
                },
                "help_full": {
                    "type": "boolean",
                    "description": "Display the full help message, hidden parameters included.",
                    "hidden": true
                },
                "show_hidden": {
                    "type": "boolean",
                    "description": "Display hidden parameters in the help message.",
                    "hidden": true
                },
                "version": {
                    "type": "boolean",
                    "description": "Display version and exit.",
                    "fa_icon": "fas fa-question-circle",
                    "hidden": true
                },
                "pipeline_version": {
                    "type": "string",
                    "description": "The pipeline version. Read back by manifest.version and by the help banner; not intended to be set on the command line.",
                    "default": "0.2.4",
                    "hidden": true
                },
                "code_dir": {
                    "type": "string",
                    "hidden": true
                },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy"
                },
                "email": {
                    "type": "string"
                },
                "email_on_fail": {
                    "type": "string"
                },
                "plaintext_email": {
                    "type": "boolean"
                },
                "validate_params": {
                    "type": "boolean",
                    "default": true,
                    "description": "Boolean whether to validate parameters against the schema at runtime",
                    "fa_icon": "fas fa-check-square",
                    "hidden": true
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "default": true
                },
                "custom_config_base": {
                    "type": "string",
                    "default": "https://raw.githubusercontent.com/nf-core/configs/master"
                },
                "trace_report_suffix": {
                    "type": "string",
                    "fa_icon": "far calendar",
                    "description": "Suffix to add to the trace report filename. Default is the date and time in the format yyyy-MM-dd_HH-mm-ss.",
                    "hidden": true
                },
                "custom_config_version": {
                    "type": "string",
                    "default": "master"
                },
                "config_profile_url": {
                    "type": "string"
                },
                "config_profile_name": {
                    "type": "string"
                },
                "config_profile_description": {
                    "type": "string"
                },
                "config_profile_contact": {
                    "type": "string"
                },
                "hook_url": {
                    "type": "string"
                },
                "gpu_cluster_options": {
                    "type": "string",
                    "description": "Cluster options added with -profile gpu.",
                    "hidden": true
                },
                "dynamic_memory": {
                    "type": "object",
                    "description": "Input-size dependent memory requests per process, see docs/RESOURCE_TUNING.md.",
                    "hidden": true
                },
                "seqtech_parameters": {
                    "type": "object",
                    "description": "Per-protocol defaults, set in conf/seqtech_parameters.config.",
                    "hidden": true
                },
                "schema_before_text": {
                    "type": "string",
                    "hidden": true
                },
                "schema_after_text": {
                    "type": "string",
                    "hidden": true
                }
            }
        },
        "trimming_options": {
            "title": "Trimming options",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "perform_trimming": {
                    "type": "boolean"
                },
                "fastp_length_required": {
                    "type": "integer",
                    "minimum": 0
                },
                "fastp_qualified_quality_phred": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_output_options"
        },
        {
            "$ref": "#/$defs/mapping_options"
        },
        {
            "$ref": "#/$defs/preprocessing_options"
        },
        {
            "$ref": "#/$defs/gene_extension_options"
        },
        {
            "$ref": "#/$defs/featurecounts_options"
        },
        {
            "$ref": "#/$defs/filtering_options"
        },
        {
            "$ref": "#/$defs/metacell_options"
        },
        {
            "$ref": "#/$defs/taxonomic_classification_options"
        },
        {
            "$ref": "#/$defs/external_pipeline_options"
        },
        {
            "$ref": "#/$defs/generic_options"
        },
        {
            "$ref": "#/$defs/trimming_options"
        }
    ]
}
