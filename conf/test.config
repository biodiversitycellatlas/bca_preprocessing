/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow test config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resource caps for test runs on tiny data (small FASTQs, toy reference).
    resourceLimits clamps every request after it is resolved, so it covers all
    withLabel tiers in conf/base.config, the task.attempt multipliers and the
    input-size dependent memory closures (params.dynamic_memory) alike.

    Use with: -profile <institution>,conda,test
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus  : 2,
        memory: 4.GB,
        time  : 1.h
    ]

    // A failure on toy data is a bug, not a resource problem: report it straight away
    maxRetries = 0
}
