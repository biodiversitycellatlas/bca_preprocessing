// Relative paths are read from the directory the pipeline is launched from, so absolute paths
// (or "${projectDir}/...", "${launchDir}/...") are the safest choice. Relative FASTQ paths
// in the samplesheet are read from the samplesheet's own folder instead.
// Values left empty count as unset: the run then stops with "Missing required parameter(s)".
params {

    // Path to the samplesheet
    input = ""

    // Path to the results directory, created if missing
    outdir = ""

    // Path(s) or URL(s) to the barcode whitelist, separated by whitespace
    bc_whitelist = ""

    // Sequencing technique
    protocol = ""

    // Reference genome files
    ref_gtf = ""
    ref_fasta = ""

}
